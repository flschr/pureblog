# Include this inside the server block for a Pure Blog Plus installation.
location ^~ /data/ { deny all; return 404; }
location ^~ /config/ { deny all; return 404; }
location ^~ /cache/ { deny all; return 404; }
location ^~ /content/autosaves/ { deny all; return 404; }
location ^~ /content/layouts/ { deny all; return 404; }
location ~* \.md$ { deny all; return 404; }
location ~* ^/content/(?:images|media)/.*\.ph(?:p[0-9]?|tml)$ { deny all; return 404; }
